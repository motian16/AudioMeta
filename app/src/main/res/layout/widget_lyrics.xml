<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件 · 歌词优先（WidgetLyricsProvider）。

  为什么长这样：
  1. 主角是歌词：歌词块 `layout_weight="1"` + `gravity="center"`，把剩下所有高度
     吃掉并垂直居中 —— 部件做大时不会在中间留一块空白（用户报告的问题）。
  2. 头部只占一行（小封面 + 曲名），够宽时再补艺术家 / 专辑：歌词风格里
     封面是配角，不该抢地方。
  3. 当前行 18sp 加粗，上一行 / 下一行 / 译文是 12/13sp 次级色，
     "够高（tall）"时四行全显示，否则只留当前行。
     没歌词时由代码写一条"暂无歌词"占位，中间那块不会塌掉。

  ⚠ 布局 id 契约见 widget_card.xml 的注释：本布局声明了全部 14 个 id。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <!-- 头部：小封面 + 曲名（够宽时有艺术家 / 专辑） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_cover_placeholder"
            android:contentDescription="@string/widget_cover" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:text="@string/widget_disconnected" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <!-- 歌词：weight=1 吃掉剩余高度，四行整体垂直居中 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_lyric_prev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="@color/widget_text_secondary"
            android:text="" />

        <TextView
            android:id="@+id/widget_lyric_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:text="@string/widget_no_lyrics" />

        <TextView
            android:id="@+id/widget_lyric_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary"
            android:text="" />

        <TextView
            android:id="@+id/widget_lyric_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="@color/widget_text_secondary"
            android:layout_marginTop="2dp"
            android:text="" />
    </LinearLayout>

    <!-- 进度条 -->
    <LinearLayout
        android:id="@+id/widget_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <ProgressBar
            android:id="@+id/widget_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:minHeight="6dp"
            android:maxHeight="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress"
            android:contentDescription="@string/widget_progress_description" />

        <TextView
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary"
            android:text="" />
    </LinearLayout>

    <!-- 控制按钮：weight 1:2:1 平分整宽 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/widget_prev"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="@string/widget_prev"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/widget_toggle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="2"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="@string/widget_toggle"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="@string/widget_next"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
</LinearLayout>
