<?xml version="1.0" encoding="utf-8"?>
<!--
  沉浸封面风格用的底部渐变遮罩。

  封面铺满整块时，白色曲名压在浅色封面上会看不清。这里在底部压一层
  从透明到深色的渐变，文字和按钮就始终有对比度。

  ⚠ 方向：shape 的 `angle` 是"渐变从哪开始" —— 0 = 左→右，90 = **下→上**，
  270 = 上→下。所以要"上面透明、下面深"必须是 270 + startColor 透明。
  这里原来写的是 90，等于深色压在上半、文字所在的底部反而是透明的 ——
  浅色封面上曲名会糊掉，这也是"部件看起来是错的"的一个来源。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#00000000"
        android:centerColor="#99000000"
        android:endColor="#E6000000" />
</shape>
